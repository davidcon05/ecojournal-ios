//
//  Config.xcconfig
//  EcoJournal
//
//  Configuration file
//  This file CAN be committed - it never contains secrets
//

// Local development overrides (gitignored, never committed)
// Create Config.local.xcconfig alongside this file and set:
//   WEATHER_API_KEY = your_key_here
#include? "Config.local.xcconfig"

// CI (Xcode Cloud): set WEATHER_API_KEY as an environment variable in the
// workflow. Xcode Cloud exposes env vars as build settings automatically,
// so $(WEATHER_API_KEY) in Info.plist resolves without any extra config here.
